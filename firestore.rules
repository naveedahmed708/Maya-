rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "naveedahmedmemon.com450@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();

      // User Settings subcollection
      match /settings/{settingId} {
        allow read, write: if isOwner(userId) && isValidId(settingId);
      }

      // User Conversations subcollection
      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId) && isValidId(conversationId);

        // Messages under a conversation
        match /messages/{messageId} {
          allow read, write: if isOwner(userId) && isValidId(messageId);
        }
      }

      // User AI Memories subcollection
      match /memories/{memoryId} {
        allow read, write: if isOwner(userId) && isValidId(memoryId);
      }

      // User Coin Transactions subcollection
      match /coinTransactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidId(txId);
        allow update, delete: if isAdmin();
      }

      // User Notifications subcollection
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId) && isValidId(notifId);
      }
    }

    // Global Admin Configurations
    match /adminConfigs/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
